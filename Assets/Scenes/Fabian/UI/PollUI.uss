/* Deckt den ganzen Bildschirm ab, Box unten zentriert */
.full-screen-overlay {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 5%; /* Abstand zum unteren Bildschirmrand */
}

/* Der äußere dunkle Kasten mit Goldrand */
.main-box {
    width: 80%;
    background-color: rgba(15, 15, 15, 0.95);
    border-color: #8c7335;
    border-width: 2px;
    padding: 30px;
    align-items: center;
}

/* Die Frage / Aussage */
.statement-text {
    color: #d4af37;
    font-size: 28px;
    -unity-font-style: italic;
    margin-bottom: 25px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* Container für die Buttons nebeneinander */
.button-container {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

/* Basis-Design für beide Buttons */
.btn {
    width: 48%;
    padding: 15px;
    font-size: 20px;
    color: white;
    border-width: 2px;
    border-radius: 3px;
    -unity-font-style: bold;
}

/* Wahr-Button (Grün) */
.btn-true {
    background-color: #2b5d34;
    border-color: #4CAF50;
}

.btn-true:hover {
    background-color: #3b7d46;
}

/* Falsch-Button (Rot) */
.btn-false {
    background-color: #5d2b2b;
    border-color: #F44336;
}

.btn-false:hover {
    background-color: #7d3b3b;
}