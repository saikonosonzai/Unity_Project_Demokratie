%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f911b9a4226273c4e913b0a6c9f4c877, type: 3}
  m_Name: D2ORH
  m_EditorClassIdentifier: Assembly-CSharp::BremenDialogueData
  lines:
  - speakerName: "Mysteri\xF6se Gestalt"
    portrait: {fileID: 21300000, guid: c88297e3e271baf449c8e849eded69e6, type: 3}
    overridePortraitLayout: 0
    customPortraitSize: {x: 250, y: 330}
    customPortraitPosition: {x: -190, y: 0}
    text: ... Ich habe dich schon erwartet.
  - speakerName: "Mysteri\xF6se Gestalt"
    portrait: {fileID: 21300000, guid: e9a6d1c69cd6d9d489bbeb4c0c86a767, type: 3}
    overridePortraitLayout: 0
    customPortraitSize: {x: 250, y: 330}
    customPortraitPosition: {x: -190, y: 0}
    text: "Mein Name ist Roland, und ich wache seit Jahrhunderten \xFCber Bremen."
  - speakerName: Roland
    portrait: {fileID: 21300000, guid: e9a6d1c69cd6d9d489bbeb4c0c86a767, type: 3}
    overridePortraitLayout: 0
    customPortraitSize: {x: 250, y: 330}
    customPortraitPosition: {x: -190, y: 0}
    text: "Ich bin kein gew\xF6hnlicher Ritter. Ich bin ein Zeichen f\xFCr Freiheit,
      Recht und Selbstbestimmung. Du fragst dich bestimmt, wie du hierher gekommen
      bist."
  - speakerName: Roland
    portrait: {fileID: 21300000, guid: e9a6d1c69cd6d9d489bbeb4c0c86a767, type: 3}
    overridePortraitLayout: 0
    customPortraitSize: {x: 250, y: 330}
    customPortraitPosition: {x: -190, y: 0}
    text: "Ich habe die Antworten f\xFCr dich \u2026 aber du musst sie dir verdienen."
  - speakerName: Roland
    portrait: {fileID: 21300000, guid: e9a6d1c69cd6d9d489bbeb4c0c86a767, type: 3}
    overridePortraitLayout: 0
    customPortraitSize: {x: 250, y: 330}
    customPortraitPosition: {x: -190, y: 0}
    text: "Das Rathaus ist einer der wichtigsten Orte in Bremen! Die W\xE4nde des
      Rathauses stehen seit Jahrhunderten f\xFCr Freiheit. Es ist ein Symbol f\xFCr
      Demokratie. "
  - speakerName: Roland
    portrait: {fileID: 21300000, guid: e9a6d1c69cd6d9d489bbeb4c0c86a767, type: 3}
    overridePortraitLayout: 0
    customPortraitSize: {x: 250, y: 330}
    customPortraitPosition: {x: -190, y: 0}
    text: "Die Objekte haben eine lange Geschichte. Doch nun bist du hier gefangen.
      Die T\xFCren nach drau\xDFen sind versiegelt, bis du alle Herausforderungen
      gemeistert hast.  "
  - speakerName: Roland
    portrait: {fileID: 21300000, guid: 6319b97ec099d844c9c71c021a223bac, type: 3}
    overridePortraitLayout: 1
    customPortraitSize: {x: 600, y: 600}
    customPortraitPosition: {x: -170, y: 0}
    text: "Die R\xE4tsel des Rathauses sind mit einem Teil der Geschichte dieses
      Geb\xE4udes verbunden. L\xF6se diese und sieh was geschieht. "
  - speakerName: Roland
    portrait: {fileID: 21300000, guid: 6319b97ec099d844c9c71c021a223bac, type: 3}
    overridePortraitLayout: 1
    customPortraitSize: {x: 600, y: 600}
    customPortraitPosition: {x: -170, y: 0}
    text: "Beim ersten R\xE4tsel gebe ich dir einen HInweis: Es hat mit der Zeit
      zu tun..."
