  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f911b9a4226273c4e913b0a6c9f4c877, type: 3}
  m_Name: D9SE
  m_EditorClassIdentifier: Assembly-CSharp::BremenDialogueData
  lines:
  - speakerName: Hausmagd
    portrait: {fileID: 21300000, guid: 05f9c3c489734c94596ccdc30a113793, type: 3}
    overridePortraitLayout: 1
    customPortraitSize: {x: 600, y: 600}
    customPortraitPosition: {x: -140, y: 0}
    text: "Du hast mir sehr geholfen, die Senatssitzung kann beginnen! Benutze deine
      M\xFCnze, die du gesammelt hast und schmei\xDF sie in das Schiffchen auf den
      Tisch. "
  - speakerName: Hausmagd
    portrait: {fileID: 21300000, guid: e4b29128924df0b448a3ccd115f07703, type: 3}
    overridePortraitLayout: 1
    customPortraitSize: {x: 600, y: 600}
    customPortraitPosition: {x: -150, y: -10}
    text: "Es ist das Spendenschiff der Seenotretter, das schon seit \xFCber 150
      Jahren existiert und vielen Personen geholfen hat. "
  - speakerName: Hausmagd
    portrait: {fileID: 21300000, guid: 1451a73770bccfb48b3420f229b3b9ed, type: 3}
    overridePortraitLayout: 1
    customPortraitSize: {x: 600, y: 600}
    customPortraitPosition: {x: -140, y: -2}
    text: "Danke f\xFCr deine Hilfe! "
