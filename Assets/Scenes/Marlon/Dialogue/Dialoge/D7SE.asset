MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f911b9a4226273c4e913b0a6c9f4c877, type: 3}
  m_Name: D7SE
  m_EditorClassIdentifier: Assembly-CSharp::BremenDialogueData
  lines:
  - speakerName: Hausmagd
    portrait: {fileID: 21300000, guid: 81c2517e11a560a47aaac22bf9e53989, type: 3}
    overridePortraitLayout: 1
    customPortraitSize: {x: 600, y: 600}
    customPortraitPosition: {x: -150, y: -2}
    text: "Oh nein, leider ist die T\xFCr zugefallen! ...Aber ich habe hier lange
      auf jemanden gewartet..."
  - speakerName: Hausmagd
    portrait: {fileID: 21300000, guid: a273818cd03eb0e488911a0274a5fb74, type: 3}
    overridePortraitLayout: 1
    customPortraitSize: {x: 600, y: 600}
    customPortraitPosition: {x: -150, y: 0}
    text: Ich arbeite schon mehrere Jahrhunderte hier und habe schon viele verschiedene
      Staatsformen und Personen kennengelernt.
  - speakerName: Hausmagd
    portrait: {fileID: 21300000, guid: 05f9c3c489734c94596ccdc30a113793, type: 3}
    overridePortraitLayout: 1
    customPortraitSize: {x: 600, y: 600}
    customPortraitPosition: {x: -150, y: 0}
    text: "Du musst mir helfen, die n\xE4chste Senatssitzung vorzubereiten!"
  - speakerName: Hausmagd
    portrait: {fileID: 21300000, guid: e4b29128924df0b448a3ccd115f07703, type: 3}
    overridePortraitLayout: 1
    customPortraitSize: {x: 600, y: 600}
    customPortraitPosition: {x: -150, y: -10}
    text: "H\xE4nge alle Bilder wieder an die richtige Position."
